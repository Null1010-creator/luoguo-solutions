#include <stdio.h>

int main()
{
    int a,b,p;
    scanf("%lld%lld%lld",%a,&b,&p);

    int x = a % p , res = 1 % p ,base = a, bb = b;

    while (bb > 0)
    {
        if (b & 1)
        {
            res = res * x % p;
        }
        x = x *x %p;（实际上作为平方运算）
        b >>= 1;
    }
    printf("%lld^%lld mod %lld=%lld\n",base,b,p,res);
}

补充 (a * b) mod p = ((a mod p) * (b mod p))  mod p;
所以实质上反复取mod并不会对结果产生影响
分析x,res,base,bb用处
x为用来反复相乘的叠加器
res为用来盛放结果的
base ，bb用来备份
