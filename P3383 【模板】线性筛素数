埃氏筛
算法核心逻辑：开始所有标记为True
0 ， 1 单独标记为False
从2开始到n，如果当前为True，则i*当前 = False
bool panduan[n];
int prime[n];
in xuhao = 0;
for (int i = 0 ; i < n ; i ++)
{
   panduan[i] = True
}
panduan[0] = panduan[1] = 0;
for (int i = 2 ; i < n ; i ++)
{
   if (panduan[i])
    {
        prime[xuhao++] = i;
        if (1ll * i * i <= n)
        {
              long long j;
              for (j = 1ll * i * i ; i <= n ; j ++)
               {
                     panduan[j] = 0;
               }
    }
 }

